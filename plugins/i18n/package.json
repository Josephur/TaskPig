{
  "name": "@taskpig/plugin-i18n",
  "version": "0.1.0",
  "private": true,
  "description": "TaskPig Localization plugin (bundled): i18n service + catalogs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@taskpig/plugin-sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
